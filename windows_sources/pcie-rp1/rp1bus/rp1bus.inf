;
; rp1bus.inf — RP1 PCIe multi-function bus driver (KMDF).
; Binds to the RP1 endpoint exposed by the Pi5 PCIe root complex (which the
; community UEFI initialises). Enumerates RP1's internal peripherals as child
; PDOs (RP1\UART0, RP1\I2C0, ...); each is matched by its own class-driver INF.
;
; Post-boot installable (pnputil /add-driver rp1bus.inf /install) — no firmware
; change needed, since RP1 itself is a standard PCIe device Windows discovers.
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = rp1bus.cat
DriverVer   = 06/25/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13                       ; driver store

[SourceDisksNames]
1 = %DiskName%,,,""
[SourceDisksFiles]
rp1bus.sys = 1

[Manufacturer]
%ProviderName% = Standard,NTARM64

; RP1 C0 endpoint: VEN_1DE4 (Raspberry Pi Ltd) / DEV_0001.
[Standard.NTARM64]
%RP1Bus.DeviceDesc% = RP1Bus_Install, PCI\VEN_1DE4&DEV_0001

[RP1Bus_Install.NT]
CopyFiles = RP1Bus_CopyFiles

[RP1Bus_CopyFiles]
rp1bus.sys

[RP1Bus_Install.NT.Services]
AddService = rp1bus, 0x00000002, RP1Bus_Service

[RP1Bus_Service]
DisplayName   = %RP1Bus.SvcDesc%
ServiceType   = 1                         ; SERVICE_KERNEL_DRIVER
StartType     = 3                         ; SERVICE_DEMAND_START
ErrorControl  = 1                         ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\rp1bus.sys

[Strings]
ProviderName        = "AprWindowsDriver (Pi5 WoA port)"
DiskName            = "RP1 Bus Driver Install Disk"
RP1Bus.DeviceDesc   = "Raspberry Pi RP1 I/O Controller (PCIe bus)"
RP1Bus.SvcDesc      = "RP1 PCIe multi-function bus driver"
