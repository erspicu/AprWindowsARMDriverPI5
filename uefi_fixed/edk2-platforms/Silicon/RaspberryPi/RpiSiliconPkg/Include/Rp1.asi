/** @file
 *
 *  RP1 ACPI device description — AprWindowsDriver (Pi5 WoA port) MODIFIED VERSION.
 *
 *  Base: worproject/edk2-platforms
 *        Silicon/RaspberryPi/RpiSiliconPkg/Include/Rp1.asi
 *        (c) 2023 Mario Bălănică — BSD-2-Clause-Patent.
 *
 *  CHANGES vs upstream: upstream only describes the two USB xHCI controllers
 *  under RP1. We ADD ACPI Device nodes for the full set of RP1 peripherals our
 *  drivers target so Windows enumerates them with proper MMIO + interrupt
 *  resources and binds our class drivers — "做法 A" (MD/Note/20260625-2230...).
 *
 *  Addresses (upstream mechanism): RP1B.PBAR = firmware-patched BAR1 base; each
 *  child window = PBAR + RP1_<periph>_BASE (Rp1.h). All children share the level
 *  interrupt RP1B.PINT (PCIE2 INTA# SPI 261); per-device demux is done by the RP1
 *  internal interrupt controller in our GPIO/bus driver, not by distinct GSIs.
 *
 *  _HID scheme: one _HID per controller TYPE (one driver binds it), instances
 *  differ by _UID (standard ACPI). Suffix must be hex digits:
 *    RPIF0001 GPIO        RPIF0002 I2C  (_UID 0-6)   RPIF0004 SPI (_UID 0-8)
 *    RPIF0005 UART (0-5)  RPIF0006 PWM  (_UID 0-1)    RPIF0007 I2S (_UID 0-2)
 *    RPIF0008 ADC         RPIF0009 Ethernet
 *  Our class-driver INFs match ACPI\RPIF000n.
 *
 **/

#include <Rp1.h>

#define RP1_QWORDMEMORY_BUF(Index)                              \
  QWordMemory (ResourceConsumer,,                               \
    MinFixed, MaxFixed, NonCacheable, ReadWrite,                \
    0x0, 0x0, 0x0, 0x0, 0x1,,, RB ## Index)

#define RP1_QWORDMEMORY_SET(Index, Offset, Length)              \
  CreateQwordField (RBUF, RB ## Index._MIN, MI ## Index)        \
  CreateQwordField (RBUF, RB ## Index._MAX, MA ## Index)        \
  CreateQwordField (RBUF, RB ## Index._LEN, LE ## Index)        \
  LE ## Index = Length                                          \
  MI ## Index = PBAR + Offset                                   \
  MA ## Index = MI ## Index + LE ## Index - 1

#define RP1_INTERRUPT_BUF(Index)                                \
  Interrupt (ResourceConsumer, Level, ActiveHigh, Shared,,,     \
             RB ## Index) { 0 }                                 \

#define RP1_INTERRUPT_SET(Index)                                \
  CreateDwordField (RBUF, RB ## Index._INT, IN ## Index)        \
  IN ## Index = PINT

// One MMIO window + the shared RP1 interrupt. Used for every simple peripheral.
#define RP1_SIMPLE_DEV(DevName, Hid, Uid, Base, Len)            \
Device (DevName) {                                              \
  Name (_HID, Hid)                                              \
  Name (_UID, Uid)                                              \
  Method (_CRS, 0, Serialized) {                                \
    Name (RBUF, ResourceTemplate () {                           \
      RP1_QWORDMEMORY_BUF (00)                                  \
      RP1_INTERRUPT_BUF (01)                                    \
    })                                                          \
    RP1_QWORDMEMORY_SET (00, Base, Len)                         \
    RP1_INTERRUPT_SET (01)                                      \
    Return (RBUF)                                               \
  }                                                             \
}

//
// ============ Upstream: USB xHCI (unchanged) ============
//
Device (XHC0) {
  Name (_HID, "PNP0D10")
  Name (_UID, 0x0)
  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
      RP1_INTERRUPT_BUF (01)
    })
    RP1_QWORDMEMORY_SET (00, RP1_USBHOST0_BASE, RP1_USBHOST_SIZE)
    RP1_INTERRUPT_SET (01)
    Return (RBUF)
  }
}
Device (XHC1) {
  Name (_HID, "PNP0D10")
  Name (_UID, 0x1)
  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
      RP1_INTERRUPT_BUF (01)
    })
    RP1_QWORDMEMORY_SET (00, RP1_USBHOST1_BASE, RP1_USBHOST_SIZE)
    RP1_INTERRUPT_SET (01)
    Return (RBUF)
  }
}

//
// ============ AprWindowsDriver additions: full RP1 peripheral set ============
//

// GPIO: GpioClx controller spanning the 3 IO banks (54 pins). Three MMIO regions
// (io_bank / sys_rio / pads_bank), each covering all 3 banks (stride 0x4000).
Device (GPI0) {
  Name (_HID, "RPIF0001")
  Name (_UID, 0x0)
  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
      RP1_QWORDMEMORY_BUF (01)
      RP1_QWORDMEMORY_BUF (02)
      RP1_INTERRUPT_BUF (03)
    })
    RP1_QWORDMEMORY_SET (00, RP1_IO_BANK0_BASE,   0xC000)
    RP1_QWORDMEMORY_SET (01, RP1_SYS_RIO0_BASE,   0xC000)
    RP1_QWORDMEMORY_SET (02, RP1_PADS_BANK0_BASE, 0xC000)
    RP1_INTERRUPT_SET (03)
    Return (RBUF)
  }
}

// UART ×6 (PL011). SerCx2. UART0 = Pi5 40-pin primary (also BT transport).
RP1_SIMPLE_DEV (UAR0, "RPIF0005", 0, RP1_UART0_BASE, 0x200)
RP1_SIMPLE_DEV (UAR1, "RPIF0005", 1, RP1_UART1_BASE, 0x200)
RP1_SIMPLE_DEV (UAR2, "RPIF0005", 2, RP1_UART2_BASE, 0x200)
RP1_SIMPLE_DEV (UAR3, "RPIF0005", 3, RP1_UART3_BASE, 0x200)
RP1_SIMPLE_DEV (UAR4, "RPIF0005", 4, RP1_UART4_BASE, 0x200)
RP1_SIMPLE_DEV (UAR5, "RPIF0005", 5, RP1_UART5_BASE, 0x200)

// I2C ×7 (DesignWare). SpbCx. I2C1 = Pi5 40-pin user bus.
RP1_SIMPLE_DEV (I2C0, "RPIF0002", 0, RP1_I2C0_BASE, 0x1000)
RP1_SIMPLE_DEV (I2C1, "RPIF0002", 1, RP1_I2C1_BASE, 0x1000)
RP1_SIMPLE_DEV (I2C2, "RPIF0002", 2, RP1_I2C2_BASE, 0x1000)
RP1_SIMPLE_DEV (I2C3, "RPIF0002", 3, RP1_I2C3_BASE, 0x1000)
RP1_SIMPLE_DEV (I2C4, "RPIF0002", 4, RP1_I2C4_BASE, 0x1000)
RP1_SIMPLE_DEV (I2C5, "RPIF0002", 5, RP1_I2C5_BASE, 0x1000)
RP1_SIMPLE_DEV (I2C6, "RPIF0002", 6, RP1_I2C6_BASE, 0x1000)

// SPI ×9 (DesignWare; SPI0-7 + the AUX SPI8). SpbCx. SPI0 = Pi5 40-pin SPI0.
RP1_SIMPLE_DEV (SPI0, "RPIF0004", 0, RP1_SPI0_BASE, 0x400)
RP1_SIMPLE_DEV (SPI1, "RPIF0004", 1, RP1_SPI1_BASE, 0x400)
RP1_SIMPLE_DEV (SPI2, "RPIF0004", 2, RP1_SPI2_BASE, 0x400)
RP1_SIMPLE_DEV (SPI3, "RPIF0004", 3, RP1_SPI3_BASE, 0x400)
RP1_SIMPLE_DEV (SPI4, "RPIF0004", 4, RP1_SPI4_BASE, 0x400)
RP1_SIMPLE_DEV (SPI5, "RPIF0004", 5, RP1_SPI5_BASE, 0x400)
RP1_SIMPLE_DEV (SPI6, "RPIF0004", 6, RP1_SPI6_BASE, 0x400)
RP1_SIMPLE_DEV (SPI7, "RPIF0004", 7, RP1_SPI7_BASE, 0x400)
RP1_SIMPLE_DEV (SPI8, "RPIF0004", 8, RP1_SPI8_BASE, 0x400)

// PWM ×2. Driver: rp1pwm.sys.
RP1_SIMPLE_DEV (PWM0, "RPIF0006", 0, RP1_PWM0_BASE, 0x100)
RP1_SIMPLE_DEV (PWM1, "RPIF0006", 1, RP1_PWM1_BASE, 0x100)

// I2S ×3 audio. Driver: rp1i2saud.sys (PortCls/WaveRT).
RP1_SIMPLE_DEV (I2S0, "RPIF0007", 0, RP1_I2S0_BASE, 0x1000)
RP1_SIMPLE_DEV (I2S1, "RPIF0007", 1, RP1_I2S1_BASE, 0x1000)
RP1_SIMPLE_DEV (I2S2, "RPIF0007", 2, RP1_I2S2_BASE, 0x1000)

// ADC + Ethernet.
RP1_SIMPLE_DEV (ADC0, "RPIF0008", 0, RP1_ADC_BASE, 0x100)
RP1_SIMPLE_DEV (ETH0, "RPIF0009", 0, RP1_ETH_BASE, 0x4000)
