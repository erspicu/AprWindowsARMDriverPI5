;
; cyw43455wifi.inf - CYW43455 Wi-Fi (NDIS registration skeleton), SDIO.
; PnP ID ACPI\RPI5WLAN (placeholder). NOTE: only the NDIS miniport registration
; is present; the dot11/WDI stack + SDIO + firmware are NOT implemented.
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGuid   = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 06/21/2026,1.0.0.0
CatalogFile = cyw43455wifi.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
cyw43455wifi.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64

[Standard.NTARM64]
%wl.DeviceDesc% = wl.ndi, ACPI\RPI5WLAN

[wl.ndi.NT]
Characteristics    = 0x84
*IfType            = 71       ; IF_TYPE_IEEE80211
*MediaType         = 16       ; NdisMediumNative802_11
*PhysicalMediaType = 9        ; NdisPhysicalMediumNative802_11
BusType            = 16       ; SDIO
AddReg             = wl.reg
CopyFiles          = Drivers_Dir

[wl.reg]
HKR, Ndi,            Service,    0, "cyw43455wifi"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "wlan"

[Drivers_Dir]
cyw43455wifi.sys

[wl.ndi.NT.Services]
AddService = cyw43455wifi, 2, wl.Service

[wl.Service]
DisplayName   = %wl.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\cyw43455wifi.sys

[Strings]
ProviderName     = "RPi5 WoA Port"
ManufacturerName = "Raspberry Pi"
DiskName         = "CYW43455 Wi-Fi Installation Disk"
wl.DeviceDesc    = "CYW43455 Wi-Fi (skeleton)"
wl.SvcDesc       = "CYW43455 Wi-Fi (NDIS)"
