;
; rp1gem.inf - RP1 Gigabit Ethernet (Cadence GEM, NDIS 6.30), ACPI-enumerated.
; PnP ID ACPI\RPIF0009 matches rp1.asi (uefi_fixed) ETH0 _HID.
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGuid   = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 06/21/2026,1.0.0.0
CatalogFile = rp1gem.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
rp1gem.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64

[Standard.NTARM64]
%rp1gem.DeviceDesc% = rp1gem.ndi, ACPI\RPIF0009

[rp1gem.ndi.NT]
Characteristics    = 0x84
*IfType            = 6        ; IF_TYPE_ETHERNET_CSMACD
*MediaType         = 0        ; NdisMedium802_3
*PhysicalMediaType = 0        ; NdisPhysicalMediumUnspecified
*IfConnectorPresent = 1
BusType            = 5
AddReg             = rp1gem.reg
CopyFiles          = Drivers_Dir

[rp1gem.reg]
HKR, Ndi,            Service,    0, "rp1gem"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

[Drivers_Dir]
rp1gem.sys

[rp1gem.ndi.NT.Services]
AddService = rp1gem, 2, rp1gem.Service

[rp1gem.Service]
DisplayName   = %rp1gem.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\rp1gem.sys

[Strings]
ProviderName      = "RPi5 WoA Port"
ManufacturerName  = "Raspberry Pi"
DiskName          = "RP1 Ethernet Installation Disk"
rp1gem.DeviceDesc = "RP1 Gigabit Ethernet (Cadence GEM)"
rp1gem.SvcDesc    = "RP1 Ethernet (NDIS)"
