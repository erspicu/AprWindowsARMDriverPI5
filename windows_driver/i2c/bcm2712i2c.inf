;
; bcm2712i2c.inf - BCM2712 BSC I2C controller (SpbCx / KMDF), ACPI-enumerated.
; PnP ID ACPI\BCM2EA1 = firmware DSDT node (placeholder; aligns with SoC ACPI).
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 06/21/2026,1.0.0.0
CatalogFile = bcm2712i2c.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
bcm2712i2c.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64

[Standard.NTARM64]
%bcm2712i2c.DeviceDesc% = bcm2712i2c_Device, ACPI\BCM2EA1

[bcm2712i2c_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
bcm2712i2c.sys

[bcm2712i2c_Device.NT.Services]
AddService = bcm2712i2c, 2, bcm2712i2c_Service

[bcm2712i2c_Service]
DisplayName   = %bcm2712i2c.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\bcm2712i2c.sys

[bcm2712i2c_Device.NT.Wdf]
KmdfService = bcm2712i2c, bcm2712i2c_wdfsect

[bcm2712i2c_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName          = "RPi5 WoA Port"
ManufacturerName      = "Raspberry Pi"
DiskName              = "BCM2712 I2C Installation Disk"
bcm2712i2c.DeviceDesc = "BCM2712 BSC I2C Controller"
bcm2712i2c.SvcDesc    = "BCM2712 I2C (SpbCx)"
