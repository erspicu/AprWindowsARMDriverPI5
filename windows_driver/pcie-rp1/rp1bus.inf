;
; rp1bus.inf - RP1 PCIe endpoint bus driver (KMDF). Binds the RP1 PCI function
; and enumerates the internal peripherals as child PDOs.
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 06/21/2026,1.0.0.0
CatalogFile = rp1bus.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
rp1bus.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64

[Standard.NTARM64]
%rp1bus.DeviceDesc% = rp1bus_Device, PCI\VEN_1DE4&DEV_0001

[rp1bus_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
rp1bus.sys

[rp1bus_Device.NT.Services]
AddService = rp1bus, 2, rp1bus_Service

[rp1bus_Service]
DisplayName   = %rp1bus.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\rp1bus.sys

[rp1bus_Device.NT.Wdf]
KmdfService = rp1bus, rp1bus_wdfsect

[rp1bus_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName      = "RPi5 WoA Port"
ManufacturerName  = "Raspberry Pi"
DiskName          = "RP1 Bus Installation Disk"
rp1bus.DeviceDesc = "RP1 I/O Controller (PCIe)"
rp1bus.SvcDesc    = "RP1 Bus Driver"
