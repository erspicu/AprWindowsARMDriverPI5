;
; bcmwdt.inf - BCM2712 PM watchdog (bespoke KMDF), ACPI-enumerated.
; PnP ID ACPI\BCM2EB2 = rp1.asl WDT0 _HID. reg @0x107D200000 (PM block, no IRQ).
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 06/21/2026,1.0.0.0
CatalogFile = bcmwdt.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
bcmwdt.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64

[Standard.NTARM64]
%bcmwdt.DeviceDesc% = bcmwdt_Device, ACPI\BCM2EB2

[bcmwdt_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
bcmwdt.sys

[bcmwdt_Device.NT.Services]
AddService = bcmwdt, 2, bcmwdt_Service

[bcmwdt_Service]
DisplayName   = %bcmwdt.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\bcmwdt.sys

[bcmwdt_Device.NT.Wdf]
KmdfService = bcmwdt, bcmwdt_wdfsect

[bcmwdt_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName       = "RPi5 WoA Port"
ManufacturerName   = "Raspberry Pi"
DiskName           = "BCM2712 Watchdog Installation Disk"
bcmwdt.DeviceDesc  = "BCM2712 PM Watchdog"
bcmwdt.SvcDesc     = "BCM2712 Watchdog (KMDF)"
