;
; bcm2712spi.inf - BCM2712 SPI controller (SpbCx / KMDF), ACPI-enumerated.
; PnP ID ACPI\BCM2EA2 = firmware DSDT node (placeholder; aligns with SoC ACPI).
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 06/21/2026,1.0.0.0
CatalogFile = bcm2712spi.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
bcm2712spi.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64

[Standard.NTARM64]
%bcm2712spi.DeviceDesc% = bcm2712spi_Device, ACPI\BCM2EA2

[bcm2712spi_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
bcm2712spi.sys

[bcm2712spi_Device.NT.Services]
AddService = bcm2712spi, 2, bcm2712spi_Service

[bcm2712spi_Service]
DisplayName   = %bcm2712spi.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\bcm2712spi.sys

[bcm2712spi_Device.NT.Wdf]
KmdfService = bcm2712spi, bcm2712spi_wdfsect

[bcm2712spi_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName          = "RPi5 WoA Port"
ManufacturerName      = "Raspberry Pi"
DiskName              = "BCM2712 SPI Installation Disk"
bcm2712spi.DeviceDesc = "BCM2712 SPI Controller"
bcm2712spi.SvcDesc    = "BCM2712 SPI (SpbCx)"
