;
; bcmmbox.inf - BCM2712 VideoCore mailbox (bespoke KMDF), ACPI-enumerated.
; PnP ID ACPI\BCM2EB0 = rp1.asl MBOX _HID. reg @0x107C013880, GIC GSIV 65.
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 06/21/2026,1.0.0.0
CatalogFile = bcmmbox.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
bcmmbox.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64

[Standard.NTARM64]
%bcmmbox.DeviceDesc% = bcmmbox_Device, ACPI\BCM2EB0

[bcmmbox_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
bcmmbox.sys

[bcmmbox_Device.NT.Services]
AddService = bcmmbox, 2, bcmmbox_Service

[bcmmbox_Service]
DisplayName   = %bcmmbox.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\bcmmbox.sys

[bcmmbox_Device.NT.Wdf]
KmdfService = bcmmbox, bcmmbox_wdfsect

[bcmmbox_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName        = "RPi5 WoA Port"
ManufacturerName    = "Raspberry Pi"
DiskName            = "BCM2712 Mailbox Installation Disk"
bcmmbox.DeviceDesc  = "BCM2712 VideoCore Mailbox"
bcmmbox.SvcDesc     = "BCM2712 Mailbox (KMDF)"
