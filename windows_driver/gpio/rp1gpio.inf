;
; rp1gpio.inf - RP1 GPIO controller (GpioClx / KMDF), ACPI-enumerated.
; PnP ID ACPI\RPIF0001 matches rp1.asi (uefi_fixed) GPIO _HID.
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 06/21/2026,1.0.0.0
CatalogFile = rp1gpio.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
rp1gpio.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64

[Standard.NTARM64]
%rp1gpio.DeviceDesc% = rp1gpio_Device, ACPI\RPIF0001

[rp1gpio_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
rp1gpio.sys

[rp1gpio_Device.NT.Services]
AddService = rp1gpio, 2, rp1gpio_Service

[rp1gpio_Service]
DisplayName   = %rp1gpio.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\rp1gpio.sys

[rp1gpio_Device.NT.Wdf]
KmdfService = rp1gpio, rp1gpio_wdfsect

[rp1gpio_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName       = "RPi5 WoA Port"
ManufacturerName   = "Raspberry Pi"
DiskName           = "RP1 GPIO Installation Disk"
rp1gpio.DeviceDesc = "RP1 GPIO Controller"
rp1gpio.SvcDesc    = "RP1 GPIO (GpioClx)"
