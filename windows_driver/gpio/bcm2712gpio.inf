;
; bcm2712gpio.inf - BCM2712 brcmstb GPIO (GpioClx / KMDF), ACPI-enumerated.
; PnP ID ACPI\BCM2EB5 = rp1.asl BGIO _HID. bank0 @0x107D508500 (GIC GSIV 276 via
; l2-intc@7d508400), bank1 @0x107D517C00. Distinct from RP1 GPIO (rp1gpio).
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 06/21/2026,1.0.0.0
CatalogFile = bcm2712gpio.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
bcm2712gpio.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64

[Standard.NTARM64]
%bcm2712gpio.DeviceDesc% = bcm2712gpio_Device, ACPI\BCM2EB5

[bcm2712gpio_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
bcm2712gpio.sys

[bcm2712gpio_Device.NT.Services]
AddService = bcm2712gpio, 2, bcm2712gpio_Service

[bcm2712gpio_Service]
DisplayName   = %bcm2712gpio.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\bcm2712gpio.sys

[bcm2712gpio_Device.NT.Wdf]
KmdfService = bcm2712gpio, bcm2712gpio_wdfsect

[bcm2712gpio_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName            = "RPi5 WoA Port"
ManufacturerName        = "Raspberry Pi"
DiskName                = "BCM2712 GPIO Installation Disk"
bcm2712gpio.DeviceDesc  = "BCM2712 GPIO Controller"
bcm2712gpio.SvcDesc     = "BCM2712 GPIO (GpioClx)"
